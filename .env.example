# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbG...VCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings

# Limits
EXEC_TIMEOUT_S=10
COMPILE_TIMEOUT_S=15
MAX_CODE_KB=64
RUNS_PER_MINUTE=30

# Sandbox
SANDBOX_IMAGE=simples-runner:latest

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Flask (apenas desenvolvimento)
FLASK_SECRET_KEY=dev-only-change-in-prod
